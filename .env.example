# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hide the "Sample" chips next to placeholder content once you've replaced it
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
# Send analytics events to /api/analytics (first-party, no cookies). Leave unset to send nothing.
# NEXT_PUBLIC_ANALYTICS=beacon

# ── Database (MongoDB primary, PostgreSQL optional) ────
# MongoDB stores contact inquiries (contact_messages) and newsletter subscribers (newsletter_subscribers)
MONGODB_URI=mongodb://127.0.0.1:27017/my_portfolio
# DATABASE_URL=

# ── Email Service (SMTP / Gmail or Resend) ────────────
# Standard Gmail SMTP configuration:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=akshayguptaa444@gmail.com
SMTP_PASS=your-google-16-character-app-password
EMAIL_FROM="Akshay Gupta <akshayguptaa444@gmail.com>"
CONTACT_TO_EMAIL=akshayguptaa444@gmail.com

# Alternatively, Resend API key:
# RESEND_API_KEY=

# ── Newsletter ───────────────────────────────────────
# Long random string used to sign unsubscribe links:
NEWSLETTER_SECRET=your-newsletter-secret
# Bearer token that protects POST /api/newsletter/notify and GET admin queries
NEWSLETTER_ADMIN_TOKEN=your-admin-token

# ── AI assistant ("Ask my portfolio") ────────────────
# Provider: anthropic | openai | mock. If unset, picked from whichever key is present, else mock.
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
